<!ATTLIST catalogue
    xmlns:xsi CDATA #IMPLIED
    xsi:noNamespaceSchemaLocation CDATA #IMPLIED>

<!ELEMENT catalogue (mountains, regions)>
<!ELEMENT mountains (mountain+)>
<!ELEMENT mountain (name, description, height, peak, thumbnail)>
<!ATTLIST mountain
    id ID #REQUIRED
    region IDREF #REQUIRED
    type CDATA #REQUIRED
    heightCategory CDATA #REQUIRED>

<!ELEMENT name (#PCDATA)>
<!ELEMENT description (#PCDATA)>
<!ELEMENT height (#PCDATA)>
<!ELEMENT peak (#PCDATA)>
<!ELEMENT thumbnail EMPTY>
<!ATTLIST thumbnail source CDATA #REQUIRED>

<!ELEMENT regions (region+)>
<!ELEMENT region (country, province, city, area)>
<!ATTLIST region
    id ID #REQUIRED>
<!ELEMENT country (#PCDATA)>
<!ELEMENT province (#PCDATA)>
<!ELEMENT city (#PCDATA)>
<!ELEMENT area (#PCDATA)>

